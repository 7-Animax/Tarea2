<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👋 Bienvenido"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#243B53"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 Gestiona tus clases de estudio"
            android:textSize="17sp"
            android:textColor="#627D98"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnHorarios"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📅 VER HORARIOS"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#345995"
            android:layout_marginTop="30dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accesos rápidos"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#243B53"
            android:layout_marginTop="35dp"/>

        <Button
            android:id="@+id/btnMaps"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="📍 Ver ubicación"
            android:layout_marginTop="15dp"/>

        <Button
            android:id="@+id/btnWeb"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="🌐 Página web"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnTelefono"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="📞 Contactar"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnCorreo"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="✉️ Enviar consulta"
            android:layout_marginTop="10dp"/>

    </LinearLayout>

</ScrollView>